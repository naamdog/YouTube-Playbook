# =========================================================================
# TEFL Heaven social-media automation pipeline — environment template
# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.
# =========================================================================

# --- Claude / Anthropic (only if using the Agent SDK / API directly) ------
ANTHROPIC_API_KEY=

# --- Higgsfield Cloud API (media generation) ------------------------------
# Get key + confirm base URL from the Higgsfield Cloud dashboard.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=        # ⚠️ confirm exact base URL / paths from dashboard

# Optional generation fallbacks
FAL_KEY=
KIE_API_KEY=
PIAPI_KEY=
REPLICATE_API_TOKEN=

# --- Blotato (posting / scheduling layer) ---------------------------------
# Requires a paid Blotato plan with API access. Key from the Settings page.
BLOTATO_API_KEY=
BLOTATO_API_BASE=          # ⚠️ confirm base URL from Blotato docs
# Per-platform account IDs configured inside Blotato:
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_YOUTUBE_ACCOUNT_ID=

# --- Media storage --------------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=        # e.g. https://media.teflheaven.com (Blotato pulls media by URL)

# --- Native platform APIs (analytics + commenting; optional if Blotato-only)
# Instagram / Meta
META_APP_ID=
META_APP_SECRET=
IG_BUSINESS_ACCOUNT_ID=
IG_LONG_LIVED_TOKEN=
# YouTube (Google OAuth)
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Trend research (optional) --------------------------------------------
APIFY_TOKEN=
ENSEMBLEDATA_TOKEN=

# --- Safety ---------------------------------------------------------------
KILL_SWITCH=false              # set true to halt all posting/commenting
REQUIRE_HUMAN_APPROVAL=true
DAILY_POST_CAP_INSTAGRAM=20    # keep below platform's ~25/24h
DAILY_POST_CAP_YOUTUBE=5       # keep below ~6/day default quota
DAILY_REPLY_CAP=30
</content>
