# =========================================================================
# TEFL Heaven social-media automation pipeline — environment template
# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.
# =========================================================================

# --- Claude / Anthropic (only if using the Agent SDK / API directly) ------
ANTHROPIC_API_KEY=

# --- Higgsfield Cloud API (media generation) ------------------------------
# Keys (an ID + SECRET pair) from cloud.higgsfield.ai/api-keys.
# Auth header used by the official SDK:  Authorization: Key <ID>:<SECRET>
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Or combined, as the official SDK accepts:  HF_KEY="<id>:<secret>"
HF_KEY=

# Per-call generation fallbacks (Soul/DoP resold here; NOT on fal/Replicate/PiAPI/Kie)
SEGMIND_API_KEY=
WAVESPEED_API_KEY=

# --- Blotato (posting / scheduling layer) ---------------------------------
# API is included on every paid plan (Starter ~$29/mo). Key from Settings > API.
# Note: keys may end in '=' (base64 padding) — keep it, or you'll get 401s.
BLOTATO_API_KEY=
BLOTATO_API_BASE=https://backend.blotato.com/v2
# Per-platform account IDs configured inside Blotato:
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_YOUTUBE_ACCOUNT_ID=

# --- Media storage --------------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=        # e.g. https://media.teflheaven.com (Blotato pulls media by URL)

# --- Native platform APIs (analytics + commenting; optional if Blotato-only)
# Instagram / Meta
META_APP_ID=
META_APP_SECRET=
IG_BUSINESS_ACCOUNT_ID=
IG_LONG_LIVED_TOKEN=
# YouTube (Google OAuth)
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Trend research (optional) --------------------------------------------
APIFY_TOKEN=               # for deep competitor scraping (/research Door 2) + TikTok trends
ENSEMBLEDATA_TOKEN=
# YOUTUBE_API_KEY (below, under native APIs) also powers /research Door 1 (free, allowed)

# --- Safety ---------------------------------------------------------------
KILL_SWITCH=false              # set true to halt all posting/commenting
REQUIRE_HUMAN_APPROVAL=true
DAILY_POST_CAP_INSTAGRAM=40    # keep below platform's ~50/24h (rolling; carousels=1)
DAILY_POST_CAP_YOUTUBE=50      # plenty of headroom under ~100/day (post-2025-12-04 quota)
DAILY_REPLY_CAP=30
